# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase project settings → API → service_role secret.
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Shared password for the /admin panel (choose your own before the party!)
ADMIN_PASSWORD=change-me

# Set to "true" only in local development to reveal the admin "Reset dati" tool.
# Leave unset (or "false") in production.
NEXT_PUBLIC_DEV_MODE=false
